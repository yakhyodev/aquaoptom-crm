[Unit]
Description=AquaOptom CRM Outbox Event Dispatcher
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/aquaoptom/backend
ExecStart=/usr/bin/php /var/www/aquaoptom/backend/artisan app:process-outbox
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
