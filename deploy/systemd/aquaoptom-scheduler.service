[Unit]
Description=AquaOptom CRM Task Scheduler
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/aquaoptom/backend
ExecStart=/usr/bin/php /var/www/aquaoptom/backend/artisan schedule:work
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
