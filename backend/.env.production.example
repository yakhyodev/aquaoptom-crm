# ==============================================================================
# AquaOptom Wholesale Beverage CRM — Production Environment Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env on your production host: cp .env.production.example .env
# 2. Generate APP_KEY using: php artisan key:generate
# 3. Generate BACKUP_ENCRYPTION_KEY using: openssl rand -base64 32
# 4. Fill in database, Redis, and Telegram credentials below.
# ==============================================================================

# Application Core
APP_NAME="AquaOptom Wholesale CRM"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://crm.aquaoptom.uz
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=uz
APP_FALLBACK_LOCALE=en

# Structured Production Logging
LOG_CHANNEL=structured
LOG_STACK=structured,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=30

# PostgreSQL 16 Database Connection
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aquaoptom_prod
DB_USERNAME=aquaoptom_db_user
DB_PASSWORD="STRONG_DATABASE_PASSWORD_HERE"
DB_SSLMODE=prefer

# Redis 7 Cache & Session
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD="STRONG_REDIS_PASSWORD_HERE"
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Session & Cache Drivers
BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
CACHE_PREFIX=aquaoptom_cache_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queue Driver
QUEUE_CONNECTION=redis

# Laravel Reverb (WebSockets)
REVERB_APP_ID=aquaoptom_app_prod
REVERB_APP_KEY=aquaoptom_key_prod
REVERB_APP_SECRET=STRONG_REVERB_SECRET_KEY_HERE
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Vite Frontend WebSocket & URL
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="crm.aquaoptom.uz"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Mail / Notifications (Optional SMTP)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@aquaoptom.uz"
MAIL_FROM_NAME="${APP_NAME}"

# Telegram Bot Integration (Prompt 19)
TELEGRAM_BOT_TOKEN="BOT_API_TOKEN_FROM_BOTFATHER"
TELEGRAM_BOT_USERNAME="AquaOptomBot"
TELEGRAM_WEBHOOK_SECRET="GENERATE_STRONG_RANDOM_SECRET_FOR_WEBHOOK"

# Backup & Disaster Recovery (Prompt 23)
# AES-256-CBC Encryption Key for pg_dump and file archives
BACKUP_ENCRYPTION_KEY="GENERATE_WITH_OPENSSL_RAND_BASE64_32"
BACKUP_RPO_MINUTES=15
BACKUP_RTO_HOURS=2

# Security Rate Limits
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120

# Private Storage Disk
FILESYSTEM_DISK=local
